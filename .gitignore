# IDE folders
.idea/
.vs/

# Caches
__pycache__
.mypy_cache
.cache/

# Build files
build/
projects/
.ninja_*
build.ninja
*.vcxproj*
*.sln*

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
*.exe
*.pdb
*.idb
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
*.bndb
xbox/
!source/**/xbox/

# --- RE workbench (freeqaz fork additions) ---
# Ghidra projects: large, machine-local, rebuildable via tools/ghidra/ghidractl
/ghidra_projects/
# Databases: caches and ledgers. config/halo/functions.sqlite is deliberately
# NOT ignored — the RE ledger is tracked so naming/status work is shared.
/cache.db
/decomp.db
/*.db-shm
/*.db-wal
# pyghidra-mcp server registry, rewritten per-machine by `ghidractl mcp`
/.mcp.json
# decomp-synth working dirs
/.decomp-synth/

# uv virtualenv (uv.lock IS tracked; the venv is not)
/.venv/
